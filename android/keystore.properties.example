# StockPilot — keystore.properties template
# -------------------------------------------
# Copy this to android/keystore.properties (gitignored) and fill in your
# release keystore credentials. NEVER commit the real keystore.properties
# or the .keystore file itself.
#
# Generate your release keystore ONCE:
#   keytool -genkey -v -keystore stockpilot.keystore -alias stockpilot \
#     -keyalg RSA -keysize 2048 -validity 36500 \
#     -dname "CN=ObandeTechHub, O=ObandeTechHub, L=Lagos, C=NG"
#
# Then back up the .keystore file to a secure off-device location
# (Google Drive encrypted folder, hardware security module, etc.).
# If you lose this keystore, you CANNOT publish updates to the same Play
# Store listing — Google requires the same signing key for the lifetime
# of the app.

storeFile=stockpilot.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=stockpilot
keyPassword=YOUR_KEY_PASSWORD
