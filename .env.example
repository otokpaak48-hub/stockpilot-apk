# StockPilot — Environment variables
# -----------------------------------
# Copy this file to .env.local (gitignored) and fill in real values.
# NEVER commit real secrets to Git.

# Cloud sync API (Business+ tier)
# Options: Supabase Edge Functions, Firebase Cloud Functions, custom Node.js backend
NEXT_PUBLIC_API_BASE=https://api.stockpilot.app

# Paystack (https://dashboard.paystack.co/api-keys)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave (https://dashboard.flutterwave.com/dashboard/settings/apis)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS gateway (for 2FA OTP — admin login, Business+ tier)
# Options: Twilio, Termii, Africa's Talking
SMS_PROVIDER=termii
SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_SENDER_ID=StockPilot

# Supabase (if using Supabase as backend)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase (if using Firebase as backend)
FIREBASE_PROJECT_ID=stockpilot-app
FIREBASE_CLIENT_EMAIL=xxxxxxxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
